{
  "name": "vendor-price-platform",
  "version": "1.0.0",
  "description": "AI-powered vendor price discovery and negotiation platform",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:setup": "node test-setup.js",
    "dev": "concurrently \"npm run dev --workspace=services/auth\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=services/auth",
    "dev:frontend": "npm run dev --workspace=frontend",
    "start": "node start.js",
    "start:backend": "npm run start --workspace=services/auth",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "setup": "npm install && npm run setup:redis",
    "setup:redis": "docker run -d --name vendor-platform-redis -p 6379:6379 redis:7-alpine",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "gh": "^2.8.9",
    "axios": "^1.5.0"
  }
}
